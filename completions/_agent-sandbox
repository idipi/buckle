_agent-sandbox() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-v[Print version information (-v)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_agent-sandbox_commands" \
"*::: :->agent-sandbox" \
&& ret=0
    case $state in
    (agent-sandbox)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:agent-sandbox-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
'-w+[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'--workspace=[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'-n+[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'--net=[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'-d+[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'--devices=[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'*--writable=[Additional directories permitted for write operations]:WRITABLE:_files' \
'*-e+[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--env=[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--pass-env=[Explicitly pass through a sensitive host environment variable]:PASS_ENV:_default' \
'--allow-home[Explicitly permit using \$HOME directory as workspace]' \
'-h[Print help]' \
'--help[Print help]' \
'*::command -- Command and arguments to execute inside the sandbox:_default' \
&& ret=0
;;
(shell)
_arguments "${_arguments_options[@]}" : \
'-w+[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'--workspace=[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'-n+[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'--net=[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
