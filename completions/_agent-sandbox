'--devices=[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'*--writable=[Additional directories permitted for write operations]:WRITABLE:_files' \
'*-e+[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--env=[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--pass-env=[Explicitly pass through a sensitive host environment variable]:PASS_ENV:_default' \
'--allow-home[Explicitly permit using \$HOME directory as workspace]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(broker)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_agent-sandbox__subcmd__broker_commands" \
"*::: :->broker" \
&& ret=0

    case $state in
    (broker)
        words=($line[1] "${words[@]}")
