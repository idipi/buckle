    case $state in
    (broker)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:agent-sandbox-help-broker-command-$line[1]:"
        case $line[1] in
            (serial-list)
_arguments "${_arguments_options[@]}" : \
