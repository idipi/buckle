#compdef buckle

autoload -U is-at-least

_buckle() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-v[Print version information (-v)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_buckle_commands" \
"*::: :->buckle" \
&& ret=0
    case $state in
    (buckle)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:buckle-command-$line[1]:"
        case $line[1] in
            (up)
_arguments "${_arguments_options[@]}" : \
'-w+[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'--workspace=[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'-n+[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'--net=[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'-d+[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'--devices=[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'*--writable=[Additional directories permitted for write operations]:WRITABLE:_files' \
'*-e+[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--env=[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--pass-env=[Explicitly pass through a sensitive host environment variable]:PASS_ENV:_default' \
'--allow-home[Explicitly permit using \$HOME directory as workspace]' \
'-h[Print help]' \
'--help[Print help]' \
'*::command -- Command and arguments to execute inside the sandbox (launches interactive shell if omitted):_default' \
&& ret=0
;;
(run)
_arguments "${_arguments_options[@]}" : \
'-w+[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'--workspace=[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'-n+[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'--net=[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'-d+[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'--devices=[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'*--writable=[Additional directories permitted for write operations]:WRITABLE:_files' \
'*-e+[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--env=[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--pass-env=[Explicitly pass through a sensitive host environment variable]:PASS_ENV:_default' \
'--allow-home[Explicitly permit using \$HOME directory as workspace]' \
'-h[Print help]' \
'--help[Print help]' \
'*::command -- Command and arguments to execute inside the sandbox:_default' \
&& ret=0
;;
(shell)
_arguments "${_arguments_options[@]}" : \
'-w+[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'--workspace=[Path to workspace directory (default\: current working directory)]:WORKSPACE:_files' \
'-n+[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'--net=[Outbound network policy\: allow, proxy, or deny]:NET:_default' \
'-d+[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'--devices=[Hardware and serial device policy\: serial, allow, or deny]:DEVICES:_default' \
'*--writable=[Additional directories permitted for write operations]:WRITABLE:_files' \
'*-e+[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--env=[Set an environment variable inside the sandbox (KEY=VAL)]:ENV:_default' \
'*--pass-env=[Explicitly pass through a sensitive host environment variable]:PASS_ENV:_default' \
'--allow-home[Explicitly permit using \$HOME directory as workspace]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(broker)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_buckle__subcmd__broker_commands" \
"*::: :->broker" \
&& ret=0

    case $state in
    (broker)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:buckle-broker-command-$line[1]:"
        case $line[1] in
            (serial-list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(usb-list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
'-t+[]:TITLE:_default' \
'--title=[]:TITLE:_default' \
'-m+[]:MESSAGE:_default' \
'--message=[]:MESSAGE:_default' \
'-s+[]:SUBTITLE:_default' \
'--subtitle=[]:SUBTITLE:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_buckle__subcmd__broker__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:buckle-broker-help-command-$line[1]:"
        case $line[1] in
            (serial-list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(usb-list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(mcp)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(version)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
