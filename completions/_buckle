&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_buckle__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:buckle-help-command-$line[1]:"
        case $line[1] in
            (up)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(run)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(shell)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(broker)
_arguments "${_arguments_options[@]}" : \
":: :_buckle__subcmd__help__subcmd__broker_commands" \
"*::: :->broker" \
&& ret=0

    case $state in
    (broker)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:buckle-help-broker-command-$line[1]:"
        case $line[1] in
            (serial-list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(usb-list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
